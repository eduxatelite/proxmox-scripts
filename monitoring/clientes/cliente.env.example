# =============================================================================
# Variables de un cliente. Copiar FUERA del repo (p.ej. /root/<cliente>.env),
# rellenar con los valores del gestor de contraseñas y lanzar:
#     ./install.sh --env /root/<cliente>.env
# Este fichero acaba en /opt/grafana-stack/.env (chmod 600). NUNCA a git.
# Contraseñas con $ ` " o espacios: entre comillas SIMPLES  →  SMTP_PASSWORD='a$b'
# =============================================================================

# ─── Identidad ───────────────────────────────────────────────────────────────
CLIENTE=nombrecliente                 # minúsculas, sin espacios (rojo, estudio1...)
CLIENTE_NOMBRE="Nombre Cliente"       # para títulos de dashboards y correos
# VM_IP=                              # opcional: se autodetecta

# ─── Módulos a activar (separados por espacios) ──────────────────────────────
# Disponibles: fortigate synology ad proxmox jumpdesktop tpn-audit deadline nuke
# (snmp se activa solo con fortigate/synology). Ver: ./install.sh --list-modules
MODULES="fortigate synology ad proxmox"

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=               # openssl rand -base64 18
# GRAFANA_PORT=3000
# GRAFANA_ANONYMOUS=false             # true = lectura sin login (pantallas de render)

# ─── Correo de alertas ───────────────────────────────────────────────────────
# Estándar: una cuenta por cliente en dinahosting → <cliente>.grafana@notificaciones.xatelite.com
ALERT_CONTACT_EMAIL=                  # destinatarios separados por ;
SMTP_PASSWORD=                        # también vale GRAFANA_SMTP_PASSWORD (nombre antiguo)
# SMTP_HOST=notificaciones-xatelite-com.correoseguro.dinaserver.com:587   # por defecto
# SMTP_USER=<cliente>.grafana@notificaciones.xatelite.com                # por defecto
# (465 → NoStartTLS y 587 → STARTTLS se eligen solos)

# ─── Vigilancia externa (Uptime Kuma de Xatélite, push monitor del cliente) ──
HEARTBEAT_URL=

# ─── Retenciones ─────────────────────────────────────────────────────────────
PROMETHEUS_RETENTION=90d
PROMETHEUS_RETENTION_SIZE=20GB        # tope por tamaño: protege el disco
LOKI_RETENTION=2160h                  # 90 días

# ─── Loki: IPs extra autorizadas a hacer push al 3100 (los DCs se añaden solos)
LOKI_ALLOWED_SOURCES=

# ─── snmp (fortigate / synology) ─────────────────────────────────────────────
SNMP_COMMUNITY=                       # openssl rand -hex 12

# ─── fortigate ───────────────────────────────────────────────────────────────
# SYSLOG_PORT_FORTI=1515              # puerto en la VM (cambiar solo si choca con algo)
# SYSLOG_PORT_UDP=1514
FORTIGATE_IP=
FORTIGATE_NAME=fortigate
# ALERT_FG_SESSIONS=40000             # calibrar según modelo y usuarios
# ALERT_FG_CPU_PCT=85
# ALERT_FG_MEM_PCT=85

# ─── synology ────────────────────────────────────────────────────────────────
NAS_TARGETS="nas01:192.0.2.10"        # nombre:ip separados por espacios
NAS_VOLUME=/volume1
# SYSLOG_PORT_NAS=1516
# ALERT_NAS_VOLUME_PCT=90
# ALERT_NAS_LOGIN_FAILS=4
# ALERT_NAS_MASS_DELETE=200

# ─── ad ──────────────────────────────────────────────────────────────────────
AD_DCS="DC01:192.0.2.2 DC02:192.0.2.3"  # nombre:ip (el nombre = label host en Loki)
# ALERT_AD_BRUTEFORCE=10              # depende del nº de empleados
# ALERT_AD_LOCKOUTS=3
# ALERT_DC_DISK_FREE_PCT=10

# ─── proxmox ─────────────────────────────────────────────────────────────────
PVE_NODES="pve01:192.0.2.21"          # alias:ip; el primero aporta métricas de cluster
PVE_USER=monitoring@pve
PVE_TOKEN_NAME=grafana
PVE_TOKEN_VALUE=
PVE_VERIFY_SSL=false
PVE_NODE_EXPORTER=no                  # yes = scrapea :9100 en los nodos

# ─── jumpdesktop ─────────────────────────────────────────────────────────────
# JUMPDESKTOP_TEAM_ID=
# JUMPDESKTOP_API_TOKEN=
# JD_LEARNING_MODE=1                  # pasar a 0 a las 1-2 semanas
# JD_WORK_START=8
# JD_WORK_END=20

# ─── deadline ────────────────────────────────────────────────────────────────
# DEADLINE_HOST=
# DEADLINE_PORT=8081
# DEADLINE_APIKEY=

# ─── nuke ────────────────────────────────────────────────────────────────────
# RLM_HOST=
# RLM_PORT=4101

# ─── Versiones (solo para fijar otra distinta a la de la plantilla) ──────────
# GRAFANA_VERSION=13.1.9
# PROMETHEUS_VERSION=v3.13.5
# LOKI_VERSION=3.7.9
