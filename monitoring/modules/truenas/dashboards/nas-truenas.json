          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "expr": "(100 * truenas_pool_allocated_bytes{nas=~\"$nas\"} / truenas_pool_size_bytes{nas=~\"$nas\"}) * on(nas, pool) group_left(status) truenas_pool_status{nas=~\"$nas\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "expr": "(truenas_pool_free_bytes{nas=~\"$nas\"}) * on(nas, pool) group_left(status) truenas_pool_status{nas=~\"$nas\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "expr": "(truenas_pool_fragmentation_percent{nas=~\"$nas\"}) * on(nas, pool) group_left(status) truenas_pool_status{nas=~\"$nas\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ONLINE": {
                        "text": "ONLINE",
                        "color": "green"
                      },
                      "DEGRADED": {
                        "text": "DEGRADED",
                        "color": "red"
                      },
                      "FAULTED": {
                        "text": "FAULTED",
                        "color": "red"
                      },
                      "OFFLINE": {
                        "text": "OFFLINE",
                        "color": "red"
                      },
                      "UNAVAIL": {
                        "text": "UNAVAIL",
                        "color": "red"
                      },
                      "REMOVED": {
                        "text": "REMOVED",
                        "color": "red"
                      }
