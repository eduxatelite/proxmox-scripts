                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uso %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
