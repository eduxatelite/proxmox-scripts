        {
          "expr": "topk(15, sum by (target_user, src_ip) (count_over_time({job=\"windows_security\", host=~\"$dc\"} | json | event_id=`4625` | regexp `Name='TargetUserName'>(?P<target_user>[^<]*)<` | regexp `Name='IpAddress'>(?P<src_ip>[^<]*)<` [$__range])))",
