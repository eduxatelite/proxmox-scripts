  # FortiGate → syslog. Promtail solo entiende RFC5424 (set format rfc5424).
  - job_name: fortigate_tcp
    syslog:
      listen_address: 0.0.0.0:1515
      listen_protocol: tcp
      idle_timeout: 60s
      label_structured_data: yes
      labels:
        job: fortigate
    relabel_configs:
      - source_labels: [__syslog_message_hostname]
        target_label: host
    pipeline_stages:
      - regex:
          expression: '.*type="(?P<type>[^"]*)".*subtype="(?P<subtype>[^"]*)".*level="(?P<level>[^"]*)".*action="(?P<action>[^"]*)".*'
      - labels:
          type:
          subtype:
          level:
          action:

  - job_name: fortigate_udp
    syslog:
      listen_address: 0.0.0.0:1514
      listen_protocol: udp
      idle_timeout: 60s
      label_structured_data: yes
      labels:
        job: fortigate
    relabel_configs:
      - source_labels: [__syslog_message_hostname]
        target_label: host
    pipeline_stages:
      - regex:
          expression: '.*type="(?P<type>[^"]*)".*subtype="(?P<subtype>[^"]*)".*level="(?P<level>[^"]*)".*action="(?P<action>[^"]*)".*'
      - labels:
          type:
          subtype:
          level:
          action:
