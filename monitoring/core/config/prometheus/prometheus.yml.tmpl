# Generado por install.sh — no editar a mano en la VM (se sobrescribe)
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  scrape_timeout: 10s
  external_labels:
    cliente: "${CLIENTE}"

# Cada módulo deja aquí su fichero (fortigate.yml, proxmox.yml, ...)
scrape_config_files:
  - /etc/prometheus/scrape.d/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: grafana
    static_configs:
      - targets: ["grafana:3000"]

  - job_name: loki
    static_configs:
      - targets: ["loki:3100"]

  - job_name: promtail
    static_configs:
      - targets: ["promtail:9080"]

  - job_name: monitoring_vm
    static_configs:
      - targets: ["node-exporter:9100"]
        labels:
          host: "${CLIENTE}-monitoring"
