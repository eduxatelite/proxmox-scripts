# Generado por install.sh — los módulos añaden sus jobs al final
server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://loki:3100/loki/api/v1/push

scrape_configs:

  # ─── Logs del sistema de la VM de monitorización ───
  - job_name: system
    static_configs:
      - targets: [localhost]
        labels:
          job: varlogs
          host: "${CLIENTE}-monitoring"
          __path__: /var/log/{messages,secure,cron}
