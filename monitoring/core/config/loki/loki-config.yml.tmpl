# Generado por install.sh — retención: LOKI_RETENTION en el .env del cliente
auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096

common:
  instance_addr: 127.0.0.1
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 100

schema_config:
  configs:
    - from: 2020-10-24
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

# Las DOS claves son necesarias para que borre: retention_period + retention_enabled
limits_config:
  retention_period: ${LOKI_RETENTION}
  ingestion_rate_mb: 16
  ingestion_burst_size_mb: 32
  query_timeout: 300s
  max_query_length: 0
  max_streams_per_user: 100000
  max_global_streams_per_user: 100000

compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  retention_delete_delay: 2h
  delete_request_store: filesystem

analytics:
  reporting_enabled: false
