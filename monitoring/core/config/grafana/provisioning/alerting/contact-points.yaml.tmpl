# Contact point y política de notificación por defecto
apiVersion: 1

contactPoints:
  - orgId: 1
    name: email-${CLIENTE}
    receivers:
      - uid: email-${CLIENTE}
        type: email
        settings:
          addresses: ${ALERT_CONTACT_EMAIL}
          singleEmail: false
        disableResolveMessage: false

policies:
  - orgId: 1
    receiver: email-${CLIENTE}
    group_by: ["grafana_folder", "alertname"]
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h
